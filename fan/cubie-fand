#!/usr/bin/env python3

import time
from pathlib import Path

HWMON_ROOT = Path("/sys/class/hwmon")

THERMAL_ROOT = Path("/sys/class/thermal")

IGNORE_ZONES = {"skin_zone"}

CURVE = [
    (45, 136),
    (50, 144),
    (55, 152),
    (60, 160),
    (70, 192),
    (80, 224),
    (88, 255),
]

MIN_PWM = 128

INTERVAL = 5
HYSTERESIS = 5


def find_fan():
    for hwmon in sorted(HWMON_ROOT.glob("hwmon*")):
        try:
            name = (hwmon / "name").read_text().strip()
        except OSError:
            continue

        if name == "pwmfan" and (hwmon / "pwm1").is_file():
            return hwmon

    raise FileNotFoundError(
        "No pwmfan hwmon device; install the cubie-pwm-fan overlay and reboot"
    )


def read_temps():
    temps = {}

    for zone in THERMAL_ROOT.glob("thermal_zone*"):
        try:
            zone_type = (zone / "type").read_text().strip()

            if zone_type in IGNORE_ZONES:
                continue

            temp = int((zone / "temp").read_text().strip()) / 1000
            temps[zone_type] = temp

        except Exception:
            pass

    return temps


def pwm_for_temp(temp, current_pwm):
    target = MIN_PWM

    for limit, pwm in CURVE:
        if temp >= limit:
            target = pwm

    pwm_levels = [MIN_PWM] + [pwm for _, pwm in CURVE]

    try:
        current_level = pwm_levels.index(current_pwm)
    except ValueError:
        current_level = 0

    try:
        target_level = pwm_levels.index(target)
    except ValueError:
        target_level = 0

    # Only apply hysteresis when decreasing speed
    if target_level < current_level:
        if current_level == 0:
            return current_pwm

        lower_limit = CURVE[current_level - 1][0]

        if temp > (lower_limit - HYSTERESIS):
            return current_pwm

    return target


def main():
    fan = find_fan()
    pwm = fan / "pwm1"
    # pwm-fan mode 1 keeps PWM enabled for nonzero duty cycles.
    (fan / "pwm1_enable").write_text("1\n")

    current_pwm = MIN_PWM
    pwm.write_text(f"{MIN_PWM}\n")

    while True:
        temps = read_temps()

        if temps:
            hottest_zone, hottest_temp = max(
                temps.items(),
                key=lambda item: item[1]
            )

            target_pwm = pwm_for_temp(
                hottest_temp,
                current_pwm
            )

            if target_pwm != current_pwm:
                pwm.write_text(f"{target_pwm}\n")
                current_pwm = target_pwm

                print(
                    f"{time.strftime('%Y-%m-%d %H:%M:%S')} "
                    f"{hottest_zone} "
                    f"{hottest_temp:.1f}°C "
                    f"PWM={current_pwm}",
                    flush=True
                )

        time.sleep(INTERVAL)


if __name__ == "__main__":
    main()
