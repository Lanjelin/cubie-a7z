[Unit]
Description=Cubie A7Z e-paper status display
Documentation=file:/opt/screen-time/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/screen-time
Environment=EPD_PLATFORM=cubie
Environment=PYTHONUNBUFFERED=1
Environment=SCREEN_TIME_INTERVAL=10
EnvironmentFile=-/etc/default/screen-time
ExecStartPre=/usr/bin/test -e /dev/spidev1.0
ExecStart=/usr/bin/python3 /opt/screen-time/screen-time.py --interval ${SCREEN_TIME_INTERVAL}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
