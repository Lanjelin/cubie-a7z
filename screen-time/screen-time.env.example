# Optional overrides for /etc/default/screen-time.
# The service file sets these defaults already; copy this file only when you
# want local machine-specific settings.

# Seconds between display refresh checks.
SCREEN_TIME_INTERVAL=10

# Optional tunnel status endpoint shown as ▲/▼ beside the IP address.
# Leave blank to skip the tunnel check entirely.
SCREEN_TIME_TUNNEL_REMOTE=

# Comma-separated listening ports hidden from the bottom-right port list.
SCREEN_TIME_HIDDEN_PORTS=111,5355
