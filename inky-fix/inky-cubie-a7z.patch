+class _CubieGPIO:
+    """GPIO request wrapper for the Cubie A7Z wiring."""
+
+    def __init__(self, chip0, chip1):
+        self._chip0 = chip0
+        self._chip1 = chip1
+
+    def set_value(self, line, value):
+        if line == "CS":
+            self._chip0.set_value(106, value)
+        elif line == "BUSY":
+            self._chip0.set_value(33, value)
+        elif line == "RESET":
+            self._chip1.set_value(6, value)
+        elif line == "DC":
+            self._chip1.set_value(7, value)
+        else:
+            raise ValueError("Unknown GPIO line {!r}".format(line))
+
+    def get_value(self, line):
+        if line == "BUSY":
+            return self._chip0.get_value(33)
+        raise ValueError("Unknown GPIO line {!r}".format(line))
+
+    def wait_edge_events(self, timeout):
+        return self._chip0.wait_edge_events(timeout)
+
+    def read_edge_events(self):
+        return self._chip0.read_edge_events()
 
 
